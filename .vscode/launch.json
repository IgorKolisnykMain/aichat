{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev(Debug)",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "environment=dev"
      ]
    },
    {
      "name": "dev(Release)",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "environment=dev"
      ]
    },
    {
      "name": "dev profile",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "environment=dev"
      ]
    },
    {
      "name": "prod",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "prod",
        "--dart-define",
        "environment=prod"
      ]
    },
    {
      "name": "Web (dev, html, chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=environment=dev"
      ],
      "deviceId": "chrome", // Ensures Chrome is targeted
      "flutterMode": "debug" // Explicitly set debug mode
    },
    {
      "name": "Integration Test (dev)",
      "request": "launch",
      "type": "dart",
      "program": "integration_test/auth_flow_test.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "environment=dev"
      ],
      "flutterMode": "debug"
    }
  ]
}