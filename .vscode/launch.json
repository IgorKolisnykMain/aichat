{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev(Debug)",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "environment=dev"
      ]
    },
    {
